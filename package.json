{
  "name": "browser-observability-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CDP-based browser diagnostics with a plugin-driven live HUD and artifact collection.",
  "exports": {
    "./browser": {
      "types": "./src/browser/index.d.ts",
      "import": "./src/browser/index.mjs",
      "default": "./src/browser/index.mjs"
    },
    "./managed": {
      "types": "./src/managed/index.d.ts",
      "import": "./src/managed/index.mjs",
      "default": "./src/managed/index.mjs"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md"
  ],
  "scripts": {
    "hud": "node src/cli/run.mjs",
    "soak": "node src/scenarios/soak/runner.mjs",
    "check": "for file in $(find src examples test -type f -name '*.mjs' | sort); do node --check \"$file\" || exit 1; done",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  }
}
